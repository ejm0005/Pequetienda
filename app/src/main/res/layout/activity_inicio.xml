<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InicioActivity"
    tools:ignore="ExtraText">

    <ImageView
        android:id="@+id/iv_icono"
        android:src="@drawable/iv_icono"
        android:layout_width="48dp"
        android:layout_height="49dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="55dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/iv_logo"
        android:src="@drawable/img_banner"
        android:layout_width="0dp"
        android:layout_height="237dp"
        android:layout_marginStart="125dp"
        android:layout_marginEnd="125dp"
        android:layout_marginTop="119dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tv_title"
        style="@style/TextoTitulo"
        android:layout_width="162dp"
        android:layout_height="38dp"
        android:text="@string/tv_title"
        android:textAlignment="center"
        android:layout_marginStart="125dp"
        android:layout_marginEnd="125dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_logo"/>

    <TextView
        android:id="@+id/tv_email"
        style="@style/TextoFormulario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_email"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>

    <EditText
        android:id="@+id/et_email"
        android:layout_width="380dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/primaryContainerClaro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_email"
        tools:ignore="SpeakableTextPresentCheck"/>

    <TextView
        android:id="@+id/tv_password"
        style="@style/TextoFormulario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_password"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        android:layout_marginTop="9dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_email"/>

    <EditText
        android:id="@+id/et_password"
        android:layout_width="380dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/primaryContainerClaro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_password"
        tools:ignore="SpeakableTextPresentCheck"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        style="@style/LabelLogin"
        android:layout_width="92dp"
        android:layout_height="59dp"
        android:layout_marginTop="42dp"
        android:layout_marginStart="166dp"
        android:layout_marginEnd="166dp"
        android:text="@string/btn_login"
        app:cornerRadius="8dp"
        app:backgroundTint="@color/primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_password"/>

    <RadioButton
        android:id="@+id/btn_terms"
        style="@style/LabelTerms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="77dp"
        android:layout_marginEnd="77dp"
        android:layout_marginTop="18dp"
        android:text="@string/btn_terms"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_login" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google"
        style="@style/LabelGoogle"
        android:layout_width="380dp"
        android:layout_height="59dp"
        android:layout_marginTop="17dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/btn_google"
        android:paddingEnd="65dp"
        app:cornerRadius="15dp"
        app:backgroundTint="@color/primaryContainerClaro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_terms"/>

    <ImageView
        android:id="@+id/iv_google"
        android:src="@drawable/iv_google"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="220dp"
        android:layout_marginEnd="120dp"
        android:layout_marginTop="11dp"
        app:layout_constraintStart_toStartOf="@+id/btn_google"
        app:layout_constraintEnd_toEndOf="@+id/btn_google"
        app:layout_constraintTop_toTopOf="@+id/btn_google"/>

    />


</androidx.constraintlayout.widget.ConstraintLayout>